// Prisma schema for Gestor ICE MVP persistence layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IceSource {
  MANUAL
  AI
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String
  status      TaskStatus @default(TODO)
  impact      Int?
  confidence  Int?
  effort      Int?
  iceScore    Int?
  iceSource   IceSource?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
